# Optional. Copy to .env.local (ignored by git). The defaults work for a local run.

# Backend API. Default: http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# 1 forces the offline mock on the Follow the Rupee page. Otherwise it is used only when the API can't be reached.
VITE_AUDIT_MOCK=

# true logs map loading details to the console.
VITE_MAP_DEBUG=
