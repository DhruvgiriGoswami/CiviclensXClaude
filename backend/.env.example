# PostgreSQL
POSTGRES_DB=civiclens
POSTGRES_USER=civiclens
POSTGRES_PASSWORD=changeme_local_dev

# Backend
DATABASE_URL=postgresql+asyncpg://civiclens:changeme_local_dev@db:5432/civiclens
DATABASE_URL_SYNC=postgresql://civiclens:changeme_local_dev@db:5432/civiclens
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MEDIA_STORAGE_PATH=/app/storage

# Admin key for DELETE /complaints/{id} and purge (sent as the X-Admin-Key header).
# Leave empty to switch admin actions off (they return 503). Never reuse the old hardcoded value.
ADMIN_API_KEY=
# local runs default to ENVIRONMENT=DEV, which keeps S3 off. Set USE_S3_STORAGE=true to override.
