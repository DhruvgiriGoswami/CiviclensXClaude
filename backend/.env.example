# Copy to .env.secrets (ignored by git) and fill in. Then run from backend/:
#   uv run --env-file .env.secrets uvicorn app.main:app --port 8000
# Every value is optional for the Follow the Rupee audit. It loads data/ into memory and needs no database.

# Claude (claude-sonnet-5-5) writes the ward brief and the citizen answers.
# Empty: both fall back to template text built from the same numbers.
ANTHROPIC_API_KEY=

# Folder with the hackathon CSVs. Defaults to ../data.
# DATA_DIR=

# PostgreSQL with PostGIS, needed only by the rest of CivicLens (representatives, complaints, budgets).
DATABASE_URL=postgresql+asyncpg://civiclens:change_me@localhost:5432/civiclens
DATABASE_URL_SYNC=postgresql://civiclens:change_me@localhost:5432/civiclens

# X-Admin-Key header for deleting or purging complaints. Empty switches those routes off (503).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Where uploaded complaint photos go when S3 is off (local runs).
MEDIA_STORAGE_PATH=./storage

# The frontend dev server.
BACKEND_CORS_ORIGINS=http://localhost:3000

# docker compose reads .env, not .env.secrets, and uses the container names:
#   POSTGRES_DB=civiclens  POSTGRES_USER=civiclens  POSTGRES_PASSWORD=change_me
#   DATABASE_URL=postgresql+asyncpg://civiclens:change_me@db:5432/civiclens
